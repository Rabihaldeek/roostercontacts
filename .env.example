# PIN required to open /contacts and download the CSV export
CONTACTS_PIN=change-me

# Postgres connection string (Neon). On Vercel this is set for you when you add Neon under Storage.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Set to 1 in production (HTTPS) so the PIN cookie is marked Secure
SECURE_COOKIES=1
